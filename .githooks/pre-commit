#!/usr/bin/env sh
set -eu

if command -v python3 >/dev/null 2>&1; then
  PY=python3
elif command -v python >/dev/null 2>&1; then
  PY=python
else
  echo "pre-commit: python3 or python is required for check_repo_hygiene.py" >&2
  exit 1
fi

if ! "$PY" scripts/check_repo_hygiene.py --staged --strict-doc-sync; then
  echo "pre-commit blocked: synchronize required docs/figures per AGENTS.md (run 'python3 scripts/render_docs_figures.py' if any .tex source changed)." >&2
  exit 1
fi
